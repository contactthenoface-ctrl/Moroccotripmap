  "faq": {
    "badge": "Good to know",
    "title": "Dakhla Lagoon FAQ",
    "q1": {
      "question": "Can I swim in the lagoon?",
      "answer": "Some edges are used for swimming; always check local conditions and currents. Many visitors come primarily for wind sports on the flat water."
    },
    "q2": {
      "question": "Best time of day on the lagoon?",
      "answer": "Late afternoon for golden light; morning for calmer shore walks before the trade wind builds."
    },
    "q3": {
      "question": "Do I need a guide for the lagoon?",
      "answer": "Not for main shore access. A local operator helps for boat trips or finding quieter stretches away from the camps."
    },
    "q4": {
      "question": "How long should I spend at the lagoon?",
      "answer": "Two to four hours for a first shore visit. Full days if you kitesurf or wingfoil."
    },
    "q5": {
      "question": "Is lagoon shore access free?",
      "answer": "Yes, general shore access is free. Camps, lessons, rentals and boat trips are paid activities."
    }
  },
