  "faq": {
    "badge": "Bon à savoir",
    "title": "FAQ Plage Quemado",
    "q1": {
      "question": "Is Quemado Beach free?",
      "answer": "Yes. It is a public urban beach. Loungers or umbrellas from private operators are optional and paid."
    },
    "q2": {
      "question": "Best time of day?",
      "answer": "Morning for quieter sand; late afternoon for softer light and a cooler swim."
    },
    "q3": {
      "question": "Facilities?",
      "answer": "In season you will find cafés, showers and basic services along the front."
    },
    "q4": {
      "question": "Safe for families?",
      "answer": "Generally yes in calm conditions; always watch children near the water."
    },
    "q5": {
      "question": "How long to spend?",
      "answer": "Two to four hours is typical; full days work if you like urban beach life."
    }
  },
