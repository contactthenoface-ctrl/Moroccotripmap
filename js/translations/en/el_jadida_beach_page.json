    "badge": "Good to Know",
    "title": "El Jadida Beach FAQ",
    "q1": {
      "question": "Is there an entry fee?",
      "answer": "Depends on the site — the cistern has a ticket; many wall sections are free."
    },
    "q2": {
      "question": "How long do I need?",
      "answer": "30 to 90 minutes for most single stops; half a day for the full Portuguese core."
    },
    "q3": {
      "question": "Best time of day?",
      "answer": "Morning for softer light in the cistern and cooler walls."
    },
    "q4": {
      "question": "Combine with what?",
      "answer": "Cistern, walls, bastion and a seafront meal in one loop."
    },
    "q5": {
      "question": "Family-friendly?",
      "answer": "Yes for walking ages; watch steps on the ramparts and slippery stone if wet."
    }
  },
