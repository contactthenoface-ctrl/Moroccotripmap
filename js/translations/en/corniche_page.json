    "title": "FAQ Nador Corniche",
    "q1": {
      "question": "Is it safe at night?",
      "answer": "Stick to the main lit promenade; usual town precautions apply."
    },
    "q2": {
      "question": "Best section to walk?",
      "answer": "Follow the lagoon-facing stretch where cafés cluster."
    },
    "q3": {
      "question": "Are there restaurants?",
      "answer": "Seafood and cafés line parts of the walk — choose busy tables."
