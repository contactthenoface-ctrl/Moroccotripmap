  "faq": {
    "badge": "Bon à savoir",
    "title": "FAQ La kasbah",
    "q1": {
      "question": "La kasbah est-elle un musée ?",
      "answer": "Non — un quartier historique avec rues publiques et bâtiments privés."
    },
    "q2": {
      "question": "L’entrée est-elle gratuite ?",
      "answer": "Oui pour les rues publiques."
    },
    "q3": {
      "question": "Combien de temps ?",
      "answer": "45 à 90 minutes pour la plupart des visiteurs."
    },
    "q4": {
      "question": "Faut-il combiner avec Bab el-Kasbah ?",
      "answer": "Oui — la porte est proche et complète la visite."
    },
    "q5": {
      "question": "Est-ce sûr ?",
      "answer": "Oui de jour ; restez sur les ruelles principales le soir."
    }
