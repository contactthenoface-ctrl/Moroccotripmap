  "faq": {
    "badge": "Bueno saber",
    "title": "FAQ La kasbah",
    "q1": {
      "question": "¿La kasbah es un museo?",
      "answer": "No — un barrio histórico con calles públicas y edificios privados."
    },
    "q2": {
      "question": "¿La entrada es gratis?",
      "answer": "Sí para las calles públicas."
    },
    "q3": {
      "question": "¿Cuánto tiempo?",
      "answer": "45 a 90 minutos para la mayoría."
    },
    "q4": {
      "question": "¿Conviene combinar con Bab el-Kasbah?",
      "answer": "Sí — la puerta está cerca y completa la visita."
    },
    "q5": {
      "question": "¿Es segura?",
      "answer": "Sí de día; mantente en callejones principales por la noche."
    }
  },
