    "title": "FAQ Sources d'Asnaa",
    "q1": {
      "question": "What are the Sources d'Asnaa?",
      "answer": "A natural water-source area on the desert edge near Dakhla — a quieter land stop compared with the lagoon camps."
    },
    "q2": {
      "question": "How do I get there?",
      "answer": "By road south or inland from town. Confirm the current track and transfer with a local driver or your camp."
    },
    "q3": {
      "question": "Do I need a 4x4?",
      "answer": "Depending on the final track condition. Many visitors go with a local driver who knows the access."
    },
    "q4": {
      "question": "Are there facilities on site?",
      "answer": "Limited. Bring water, sun protection and plan your return before dark."
    },
    "q5": {
      "question": "Best time to visit?",
      "answer": "Morning for cooler air and clearer light on the desert edge."
    }
