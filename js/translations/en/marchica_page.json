  "faq": {
    "badge": "Good to know",
    "title": "FAQ Marchica Lagoon (Mar Chica)",
    "q1": {
      "question": "Can I swim in the lagoon?",
      "answer": "Some edges are used for swimming; always check local conditions. Clearer swimming is often better at open-coast beaches like Charrana."
    },
    "q2": {
      "question": "Are there flamingos?",
      "answer": "Seasonal — more likely at certain times of year along quieter shores."
    },
    "q3": {
      "question": "Best time of day?",
      "answer": "Late afternoon and evening for light and corniche energy."
    },
    "q4": {
      "question": "Do I need a guide?",
      "answer": "Not for the main promenade edges; useful for boat segments."
    },
    "q5": {
      "question": "How long to spend?",
      "answer": "Two to four hours for a first walk and sunset is typical."
    }
