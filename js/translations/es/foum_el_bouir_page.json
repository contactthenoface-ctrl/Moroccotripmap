  "faq": {
    "badge": "Bueno saber",
    "title": "FAQ Foum El Bouir",
    "q1": {
      "question": "How far is Foum El Bouir from the lagoon camps?",
      "answer": "A drive across or along the peninsula. Confirm transfer time with your base."
    },
    "q2": {
      "question": "Is it beginner-friendly?",
      "answer": "Ocean swell is more demanding than lagoon flat water. Beginners usually start on the lagoon."
    },
    "q3": {
      "question": "Can I swim at Foum El Bouir?",
      "answer": "Only when conditions are clearly safe. This is open Atlantic, not sheltered lagoon water."
    },
    "q4": {
      "question": "Are there facilities?",
      "answer": "Limited compared with lagoon camps. Pack water, shade and what you need."
    },
    "q5": {
      "question": "Worth visiting without surfing?",
      "answer": "Yes, for the open coastline and a change of landscape from the lagoon."
    }
  },
