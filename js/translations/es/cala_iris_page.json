    "title": "FAQ Cala Iris",
    "q1": {
      "question": "How far from Al Hoceima?",
      "answer": "A coastal drive west into the park zone — confirm duration with your driver."
    },
    "q2": {
      "question": "Worth it without a car?",
      "answer": "Yes if you arrange a taxi or tour; public options may be limited."
    },
    "q3": {
      "question": "Swimming?",
      "answer": "Possible in calm conditions; this is a more natural cove than town beaches."
    },
    "q4": {
      "question": "Combine with Torres de Alcalá?",
      "answer": "Yes — both sit on the broader park coast and pair well in one day."
    },
    "q5": {
      "question": "Food on site?",
      "answer": "Very limited — pack water and snacks or eat before/after in town."
    }
