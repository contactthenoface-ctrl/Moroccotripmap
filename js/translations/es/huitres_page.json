    "badge": "Bueno saber",
    "title": "FAQ Granjas de ostras",
    "q1": {
      "question": "Do I need a reservation for oyster tasting?",
      "answer": "Often yes in peak season. Ask your hotel or camp to confirm which farms welcome visitors on your dates."
    },
    "q2": {
      "question": "How much does a tasting cost?",
      "answer": "Prices vary by farm and platter size. Confirm before you sit down."
    },
    "q3": {
      "question": "Are there options if I do not eat oysters?",
      "answer": "This stop is mainly about oysters. Plan another meal in town or at camp if needed."
    },
    "q4": {
      "question": "How long does a farm visit take?",
      "answer": "One to two hours including transfer is typical."
    },
    "q5": {
      "question": "Can I combine oysters with the White Dune?",
      "answer": "Yes, on a shared lagoon outing if timing and opening hours fit."
    }
