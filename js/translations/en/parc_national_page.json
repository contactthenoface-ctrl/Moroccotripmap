    "title": "Al Hoceima National Park FAQ",
    "q1": {
      "question": "Do I need a guide?",
      "answer": "Not for main viewpoints; useful for longer trails or boat approaches to remote coves."
    },
    "q2": {
      "question": "Can I swim in the park?",
      "answer": "Some coves allow swimming; check local conditions and any seasonal rules."
    },
    "q3": {
      "question": "Best season for hiking?",
      "answer": "Spring and autumn for milder temperatures on exposed cliffs."
    },
    "q4": {
      "question": "How far from town?",
      "answer": "Trailheads and park coast sites are a drive west — confirm times with a taxi or tour."
    },
    "q5": {
      "question": "Is it suitable for children?",
      "answer": "Viewpoints yes; longer cliff paths need care and proper footwear."
    }
