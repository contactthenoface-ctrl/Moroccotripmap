  "faq": {
    "badge": "Bon à savoir",
    "title": "FAQ Lagune Marchica (Mar Chica)",
    "q1": {
      "question": "Peut-on se baigner dans la lagune ?",
      "answer": "Certains bords sont utilisés pour la baignade ; vérifiez les conditions. La baignade plus claire est souvent sur des plages comme Charrana."
    },
    "q2": {
      "question": "Y a-t-il des flamants ?",
      "answer": "Saisonnier — plus probable à certaines périodes sur les rives calmes."
    },
    "q3": {
      "question": "Meilleur moment de la journée ?",
      "answer": "Fin d’après-midi et soir pour la lumière et la corniche."
    },
    "q4": {
      "question": "Faut-il un guide ?",
      "answer": "Pas pour la promenade principale ; utile pour les segments en bateau."
    },
    "q5": {
      "question": "Combien de temps prévoir ?",
      "answer": "Deux à quatre heures pour une première marche et le coucher de soleil."
    }
