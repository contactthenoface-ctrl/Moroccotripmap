    "q2": {
      "question": "Where is the best viewpoint?",
      "answer": "Ask your camp or driver for the classic silhouette angle across the lagoon."
    },
    "q3": {
      "question": "How long does a Dragon Island visit take?",
      "answer": "One to two hours including transfer is typical for a viewpoint stop."
    },
    "q4": {
      "question": "Is there birdlife?",
      "answer": "Possible. Keep distance and avoid disturbing nesting areas."
    },
    "q5": {
      "question": "Do I need a boat tour?",
      "answer": "Not for distant shore views. A boat is useful if you want to approach the islet more closely."
