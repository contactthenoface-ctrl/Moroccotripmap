  "faq": {
    "badge": "Bueno saber",
    "title": "FAQ Laguna Marchica (Mar Chica)",
    "q1": {
      "question": "¿Se puede nadar en la laguna?",
      "answer": "Algunos bordes se usan para nadar; comprueba las condiciones. El baño más claro suele estar en playas como Charrana."
    },
    "q2": {
      "question": "¿Hay flamencos?",
      "answer": "De temporada — más probable en orillas tranquilas."
    },
    "q3": {
      "question": "¿Mejor momento del día?",
      "answer": "Final de tarde y noche para la luz y la corniche."
    },
    "q4": {
      "question": "¿Hace falta guía?",
      "answer": "No para el paseo principal; útil para tramos en barco."
    },
    "q5": {
      "question": "¿Cuánto tiempo?",
      "answer": "Dos a cuatro horas para un primer paseo y el atardecer."
    }
  },
