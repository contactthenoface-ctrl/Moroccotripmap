  "faq": {
    "badge": "Bueno saber",
    "title": "FAQ — Playa de El Jadida",
    "q1": {
      "question": "¿Hay entrada de pago?",
      "answer": "Según el sitio — la cisterna tiene entrada; muchos tramos de muralla son libres."
    },
    "q2": {
      "question": "¿Cuánto tiempo necesito?",
      "answer": "30 a 90 minutos para la mayoría de paradas; media jornada para el núcleo portugués."
    },
    "q3": {
      "question": "¿Mejor momento del día?",
      "answer": "Por la mañana para luz más suave en la cisterna y murallas más frescas."
    },
    "q4": {
      "question": "¿Con qué combinarlo?",
      "answer": "Cisterna, murallas, bastión y una comida junto al mar en el mismo circuito."
    },
    "q5": {
      "question": "¿Apto para familias?",
      "answer": "Sí si los niños caminan; cuidado con los escalones en las murallas."
    }
  },
