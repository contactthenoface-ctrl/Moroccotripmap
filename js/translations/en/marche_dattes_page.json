    "title": "Date market FAQ",
    "q1": {
      "question": "Which variety?",
      "answer": "Sellers can point you to softer or firmer types; taste a sample when offered."
    },
    "q2": {
      "question": "Only in Erfoud?",
      "answer": "Dates are regional, but Erfoud is a convenient place to buy during a Tafilalet stop."
    },
    "q3": {
      "question": "How long to stop?",
      "answer": "30 to 60 minutes is enough."
    },
    "q4": {
      "question": "Can I negotiate?",
      "answer": "A polite discussion on price is normal for larger amounts."
    },
    "q5": {
      "question": "How to store them?",
      "answer": "Keep dry and reasonably cool; they keep for weeks."
    }
